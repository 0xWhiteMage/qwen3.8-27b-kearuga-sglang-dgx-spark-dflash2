# Qwen3.8-27B Kearuga on one DGX Spark (GB10 / SM121), via SGLang.
# Copy this file to .env, then start one serving profile:
#
# DFlash 2 (fastest C1/C4 interactive daily driver):
#   ./start-dflash2.sh
#
# DFlash defaults = four admitted requests with a 1,048,576-token pool.
# Each request retains the native 262,144-token context, so all four requests
# can simultaneously reach the full context limit.

# Reasoning & Thinking Effort (low, medium, high, xhigh)
REASONING_EFFORT=medium
TEMPERATURE=0.6
TOP_P=0.95

# Network & Server Settings
PORT=8888
HOST=0.0.0.0
SERVED_MODEL_NAME=qwen3.8-27b-sglang

# Context & Memory Bounds
CONTEXT_LENGTH=262144
MAX_CONCURRENT_REQUESTS=4
MAX_TOTAL_TOKENS=1048576
CHUNKED_PREFILL=8192
MEM_FRACTION=0.85

# Hardware & Blackwell SM121 Optimizations
CPU_AFFINITY=5-9,15-19
CPUSET=5-9,15-19
CUDA_GRAPH_MAX_BS=4

# Drafter profile: kearuga = Kearuga-distilled NVFP4 drafter, K=12, vendored
# 64K draft-head overlay + token map (hash-verified at launch).
# stock = z-lab BF16 drafter, K=10, no overlay (the v0.5.0 recipe).
DRAFTER_PROFILE=kearuga

# DFlash 2 Settings (K=12 validated with the Kearuga drafter; with the 64K
# draft head vs stock K=10: code/math/tool calls +23–26 %, prose/IFEval
# +9–11 % C1 net decode. Use K=10 for the stock profile.)
DFLASH_DRAFT_WINDOW_SIZE=2048
DFLASH_DRAFT_TOKENS=12
KV_CACHE_DTYPE=bf16
DFLASH_IMAGE=lmsysorg/sglang@sha256:616a3e97f45191af975896cfa644279096cb31bd408a071c2e99ca7209c3cafe
TARGET_MODEL=0xWhiteMage/Qwen3.8-27B-Kearuga
DFLASH_MODEL=0xWhiteMage/Qwen3.8-27B-Kearuga-DFlash2
DFLASH_REV=39a26bd8109a70e28363a3267998a6d2be83bdbb
DFLASH_DRAFT_QUANT=modelopt_fp4
DFLASH_OVERLAY=1
# DFLASH_TOKEN_MAP=/abs/path/to/draft-vocab-v4-top65650.pt   # default = <repo>/drafter/draft-vocab-v4-top65650.pt; absolute path

# SGLang Request Priorities
PRIORITY_SCHEDULING=1
DEFAULT_PRIORITY_VALUE=0
PRIORITY_PREEMPTION_THRESHOLD=10

