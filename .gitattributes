# Enforce LF line endings for all code, shell scripts, and manifests
* text=auto eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
MANIFEST.sha256 text eol=lf
*.pt binary
# Vendored, hash-pinned drafter assets: store bytes verbatim (a clone must reproduce drafter/SHA256SUMS)
drafter/** -text
